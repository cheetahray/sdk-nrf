                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="check_sender" value="sender_task_tgr(0)&lt;br&gt;!= 0?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="110" y="480" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;" edge="1" parent="1" source="phy_calc" target="check_sender">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="ack_resp" value="檢查 ACK 響應：&lt;br&gt;比對 device_info_form&lt;br&gt;設置 ack_remote_resp&lt;br&gt;return" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="110" y="600" width="180" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="edge4" value="是 (sender)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="check_sender" target="ack_resp">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="check_scanner" value="scanner_task==0&lt;br&gt;|| scanner_inactive&lt;br&gt;|| !round_phy_sel?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
