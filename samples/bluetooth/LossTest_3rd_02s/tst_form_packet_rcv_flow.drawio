                </mxCell>
                <mxCell id="init" value="初始化變數：&lt;br&gt;• rcv_stamp_lc&lt;br&gt;• 提取 node, pri_phy, sec_phy&lt;br&gt;• 計算 info_rssi" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
