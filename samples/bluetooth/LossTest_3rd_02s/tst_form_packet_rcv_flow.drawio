                </mxCell>
                <mxCell id="phy_calc" value="根據 PHY 計算 index：&lt;br&gt;• 1M+2M → index=0&lt;br&gt;• 1M+1M → index=1&lt;br&gt;• Coded+Coded → index=2&lt;br&gt;• 1M+None → index=3&lt;br&gt;• 其他 → return" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="90" y="330" width="220" height="120" as="geometry"/>
                </mxCell>
