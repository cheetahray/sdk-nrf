        <!-- 說明框 -->
        <mxCell id="notes-title" value="重要限制說明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="530" width="750" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="notes-content" value="① BLE 4.x Legacy Advertising 最大 31 bytes（包含所有 AD Type headers）&#xa;② 無法像 Extended Advertising 那樣使用多個獨立 AD Types&#xa;③ tail[10] 空間被複用：可放設備名稱，節省額外 AD Type 開銷&#xa;④ 實際封包：3 (Flags) + 2 (Man Data Header) + 26 (Payload) = 31 bytes&#xa;⑤ man_id = 0xFFFF (測試用), form_id = 0xBAAB (Loss Test 識別碼)&#xa;⑥ eui_64 使用 Big-Endian (網路位元組序)，確保跨平台相容" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="750" height="120" as="geometry"/>
        </mxCell>
        
