&uart1_default {
	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 30)>;
	};

	group2 {
		psels = <NRF_PSEL(UART_RX, 0, 31)>;
	};
};

&uart1 {
    status = "okay";
};
