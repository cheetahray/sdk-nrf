/ {
    rtt-uart {
        compatible = "segger,rtt-uart";
    };

    chosen {
        //ephyr,bt-c2h-uart = &uart0;
        //ephyr,bt-mon-uart = &uart0;
        //ephyr,console = &uart0;
        //ephyr,shell-uart = &uart0;
        //ephyr,uart-mcumgr = &uart0;
		zephyr,bt-c2h-uart = &{/rtt-uart/};
		zephyr,bt-mon-uart = &{/rtt-uart/};
		zephyr,console = &{/rtt-uart/};
		zephyr,shell-uart = &{/rtt-uart/};
		zephyr,uart-mcumgr = &{/rtt-uart/};
};
	DIO:zephyr,user {
		dio-gpios = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>,
					<&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>,
					<&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>,
					<&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
		status = "okay";
	};
};

&uart0_default {
	group2 {
		psels = <NRF_PSEL(UART_RX, 0, 5)>;
	};

	group1 {
		psels = <NRF_PSEL(UART_TX, 0, 11)>, <NRF_PSEL(UART_RTS, 1, 9)>;
	};
};
